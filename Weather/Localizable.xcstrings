          }
        }
      }
    },
    "Use your location to find nearby places with more sunny hours." : {
      "comment" : "Message shown when location access is needed to find nearby places with more sunny hours than the current location.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie Ihren Standort, um Orte in der Nähe mit mehr Sonnenstunden zu finden."
          }
