    "Use your location to find the nearest fully sunny city." : {
      "comment" : "Message shown when the user has not yet granted location access, encouraging them to do so.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzen Sie Ihren Standort, um die nächstgelegene vollsonnige Stadt zu finden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use your location to find the nearest fully sunny city."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilice su ubicación para encontrar la ciudad completamente soleada más cercana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez votre position pour trouver la ville entièrement ensoleillée la plus proche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la tua posizione per trovare la città completamente soleggiata più vicina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在地を使用して、最も近い完全に晴れた都市を見つけます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "귀하의 위치를 ​​사용하여 가장 가까운 완전히 맑은 도시를 찾으십시오."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use sua localização para encontrar a cidade totalmente ensolarada mais próxima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте свое местоположение, чтобы найти ближайший полностью солнечный город."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用您的位置查找最近的阳光明媚的城市。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用您的位置尋找最近的陽光明媚的城市。"
          }
        }
      }
    },
