    "Location access is off. Allow it in Settings to show your local timeline and nearest sunny place." : {
      "comment" : "A message displayed when the user has denied location access.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standortzugriff ist deaktiviert. Erlauben Sie es in den Einstellungen, Ihre lokale Zeitleiste und den nächstgelegenen sonnigen Ort anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location access is off. Allow it in Settings to show your local timeline and nearest sunny place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a la ubicación está desactivado. Permítale en Configuración mostrar su línea de tiempo local y el lugar soleado más cercano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès à la localisation est désactivé. Autorisez-le dans Paramètres pour afficher votre chronologie locale et l'endroit ensoleillé le plus proche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesso alla posizione è disattivato. Consentilo in Impostazioni per mostrare la cronologia locale e il luogo soleggiato più vicino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報へのアクセスがオフになっています。設定で許可すると、ローカルのタイムラインと最も近い日当たりの良い場所が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치 액세스가 사용 중지되었습니다. 설정에서 허용하여 현지 타임라인과 가장 가까운 햇볕이 잘 드는 장소를 표시하세요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso ao local está desativado. Permita que em Configurações mostre sua linha do tempo local e o local ensolarado mais próximo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к местоположению отключен. Разрешите это в настройках, чтобы отображать местную шкалу времени и ближайшее солнечное место."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置访问已关闭。在“设置”中允许它显示您当地的时间线和最近的阳光明媚的地方。"
          }
        },
        "zh-Hant" : {
