        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se eliminará de «Todos los lugares» y de todas las colecciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sera supprimé de « Tous les lieux » et de chaque collection."
