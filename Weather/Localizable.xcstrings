    "Collections are optional. All saved places remain available in All Places." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammlungen sind optional. Alle gespeicherten Orte bleiben unter „Alle Orte“ verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collections are optional. All saved places remain available in All Places."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las colecciones son opcionales. Todos los lugares guardados permanecen disponibles en «Todos los lugares»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les collections sont facultatives. Tous les lieux enregistrés restent disponibles dans « Tous les lieux »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le raccolte sono facoltative. Tutti i luoghi salvati rimangono disponibili in Tutti i luoghi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コレクションは任意です。保存した場所はすべて「すべての場所」に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컬렉션은 선택 사항입니다. 저장한 모든 장소는 계속 ‘모든 장소’에서 볼 수 있습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As coleções são opcionais. Todos os locais guardados permanecem disponíveis em “Todos os locais”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коллекции необязательны. Все сохранённые места остаются в разделе «Все места»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集合是可选的。所有已保存地点仍可在“所有地点”中找到。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集合並非必要。所有已儲存的地點仍可在「所有地點」中找到。"
          }
        }
      }
    },
    "Collections are optional. Create one when you want to group places." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammlungen sind optional und können zum Gruppieren von Orten erstellt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collections are optional. Create one when you want to group places."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las colecciones son opcionales. Crea una cuando quieras agrupar lugares."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les collections sont facultatives. Créez-en une lorsque vous souhaitez regrouper des lieux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le raccolte sono facoltative. Creane una quando desideri raggruppare i luoghi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コレクションは任意です。場所をまとめたいときに作成できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컬렉션은 선택 사항입니다. 장소를 그룹으로 묶고 싶을 때 만드세요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As coleções são opcionais. Crie uma quando quiser agrupar locais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коллекции необязательны. Создайте коллекцию, когда захотите сгруппировать места."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
