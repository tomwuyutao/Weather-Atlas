    "Centers the map on your current location and highlights it." : {
      "comment" : "An accessibility hint for the \"Center on Current Location\" button in the map view.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zentriert die Karte auf Ihren aktuellen Standort und hebt ihn hervor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Centers the map on your current location and highlights it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Centra el mapa en tu ubicación actual y lo resalta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Centre la carte sur votre position actuelle et la met en surbrillance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Centra la mappa sulla tua posizione corrente e la evidenzia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
