    "Location access is off. Allow it in Settings to show your local timeline and nearby sunnier places." : {
      "comment" : "A message displayed when the user has denied location access.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standortzugriff ist deaktiviert. Erlauben Sie ihn in den Einstellungen, um Ihre lokale Zeitleiste und sonnigere Orte in der Nähe anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location access is off. Allow it in Settings to show your local timeline and nearby sunnier places."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a la ubicación está desactivado. Permítelo en Ajustes para mostrar tu cronología local y lugares más soleados cercanos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à la localisation est désactivé. Autorisez-le dans Réglages pour afficher votre chronologie locale et des lieux plus ensoleillés à proximité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso alla posizione è disattivato. Consentilo in Impostazioni per mostrare la tua cronologia locale e luoghi più soleggiati nelle vicinanze."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報へのアクセスがオフです。設定で許可すると、ローカルのタイムラインと近くのより日当たりのよい場所を表示できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치 접근이 꺼져 있습니다. 설정에서 허용하면 지역 타임라인과 주변의 더 햇살 좋은 장소를 볼 수 있습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à localização está desativado. Permita-o em Definições para mostrar a sua linha temporal local e locais mais ensolarados nas proximidades."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к геопозиции отключен. Разрешите его в Настройках, чтобы увидеть местную шкалу времени и более солнечные места поблизости."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置访问已关闭。请在“设置”中允许访问，以显示本地时间线和附近更晴朗的地点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
