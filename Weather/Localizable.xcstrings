    "Use your current location, or choose a home location to keep using every time you open Weather Atlas." : {
      "comment" : "A description of how to set a home location for Weather Atlas.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze deinen aktuellen Standort oder wähle einen Startort, der bei jedem Öffnen von Weather Atlas verwendet wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use your current location, or choose a home location to keep using every time you open Weather Atlas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa tu ubicación actual o elige una ubicación de inicio para usarla cada vez que abras Weather Atlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez votre position actuelle ou choisissez un lieu de résidence à utiliser à chaque ouverture de Weather Atlas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la posizione attuale oppure scegli una posizione principale da usare ogni volta che apri Weather Atlas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在地を使うか、Weather Atlasを開くたびに使うホーム位置を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 위치를 사용하거나 Weather Atlas를 열 때마다 사용할 집 위치를 선택하세요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a sua localização atual ou escolha uma localização de casa para usar sempre que abrir o Weather Atlas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте текущее местоположение или выберите домашнее, которое будет использоваться при каждом открытии Weather Atlas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
