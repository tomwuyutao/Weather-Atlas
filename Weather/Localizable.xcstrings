        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La opción de país estará disponible cuando se determine el país actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’option de pays sera disponible une fois le pays actuel déterminé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’opzione del paese sarà disponibile dopo il rilevamento del paese attuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在地の国を特定すると、国のオプションを利用できるようになります。"
