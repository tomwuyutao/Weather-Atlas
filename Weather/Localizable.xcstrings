    "When enabled, cities across a nearby international border are excluded." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, cities across a nearby international border are excluded."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn diese Option aktiviert ist, werden Städte jenseits einer nahegelegenen internationalen Grenze ausgeschlossen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando esta opción está activada, se excluyen las ciudades al otro lado de una frontera internacional cercana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est activée, les villes situées de l’autre côté d’une frontière internationale proche sont exclues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se abilitata, sono escluse le città oltre un confine internazionale vicino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにすると、近くの国境を越えた都市は除外されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 가까운 국경 너머의 도시는 제외됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativada, esta opção exclui cidades situadas do outro lado de uma fronteira internacional próxima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено, города за ближайшей государственной границей исключаются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，将排除附近国境另一侧的城市。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，會排除附近國界另一側的城市。"
          }
        }
      }
    },
    "When enabled, Weather Atlas updates nearby recommendations after launch if location access was already granted." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, Weather Atlas updates nearby recommendations after launch if location access was already granted."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, aktualisiert Weather Atlas nach dem Start die Empfehlungen für die Umgebung, sofern der Standortzugriff bereits erlaubt wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando esta opción está activada, Weather Atlas actualiza las recomendaciones cercanas tras el inicio si ya se había concedido acceso a la ubicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est activée, Weather Atlas actualise les recommandations à proximité après son lancement si l’accès à la localisation a déjà été autorisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se l’opzione è attiva, Weather Atlas aggiorna i consigli nelle vicinanze dopo l’avvio se l’accesso alla posizione è già stato concesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにすると、位置情報へのアクセスがすでに許可されている場合、Weather Atlasは起動後に近くのおすすめを更新します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 위치 접근 권한이 이미 허용된 경우 Weather Atlas가 앱 실행 후 주변 추천을 업데이트합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando esta opção está ativada, o Weather Atlas atualiza as recomendações nas proximidades após o arranque, caso o acesso à localização já tenha sido concedido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено и доступ к геопозиции уже разрешён, Weather Atlas обновляет рекомендации поблизости после запуска."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，如果位置权限已获准，Weather Atlas 会在启动后更新附近推荐。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，如果位置權限已獲准，Weather Atlas 會在啟動後更新附近推薦。"
          }
        }
      }
    },
