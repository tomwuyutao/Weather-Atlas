    "The circle shows the selected radius. Markers show the population-ranked dataset candidates." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The circle shows the selected radius. Markers show the population-ranked dataset candidates."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kreis zeigt den ausgewählten Radius. Die Markierungen zeigen die nach Einwohnerzahl ausgewählten Städte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El círculo muestra el radio seleccionado. Los marcadores muestran las ciudades candidatas ordenadas por población."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cercle indique le rayon sélectionné. Les marqueurs indiquent les villes retenues selon leur population."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il cerchio mostra il raggio selezionato. I marcatori indicano le città candidate ordinate per popolazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "円は選択した半径を示します。マーカーは、人口順に選ばれたデータセット内の候補都市を示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원은 선택한 반경을 나타냅니다. 마커는 데이터셋에서 인구순으로 선정된 후보 도시를 나타냅니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O círculo mostra o raio selecionado. Os marcadores mostram as cidades candidatas ordenadas por população."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Круг показывает выбранный радиус. Метки показывают города-кандидаты из набора данных, отобранные по численности населения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圆圈表示所选半径。标记表示数据集中按人口排名的候选城市。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圓圈表示所選半徑。標記表示資料集中依人口排名的候選城市。"
          }
        }
      }
    },
    "The country could not be resolved, so country limiting is unavailable." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The country could not be resolved, so country limiting is unavailable."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Land konnte nicht ermittelt werden. Die Beschränkung auf ein Land ist daher nicht verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido determinar el país, así que no se puede limitar la búsqueda por país."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pays n’a pas pu être déterminé. Il est donc impossible de limiter la recherche à un pays."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile rilevare il paese, quindi non è possibile limitare la ricerca per paese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "国を特定できなかったため、国による絞り込みは利用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "국가를 확인할 수 없어 국가 제한을 사용할 수 없습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível determinar o país, pelo que não é possível limitar a pesquisa por país."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось определить страну, поэтому ограничение по стране недоступно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法确定国家或地区，因此无法使用国家或地区限制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法判斷國家或地區，因此無法使用國家或地區限制。"
          }
        }
      }
    },
    "The country option becomes available after the current country is resolved." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The country option becomes available after the current country is resolved."
          }
