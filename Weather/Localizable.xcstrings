        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca cualquier lugar del mapa para buscar en esa zona. O usa el botón Buscar sol para ampliar la búsqueda."
          }
        },
        "fr" : {
          "stringUnit" : {
