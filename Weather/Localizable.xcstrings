        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地図上の任意の場所をタップしてそのエリアを検索できます。または、「日差しを探す」ボタンでより広く検索できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지도에서 원하는 곳을 탭해 해당 지역을 검색하세요. 또는 햇살 찾기 버튼으로 더 넓게 검색할 수 있습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
