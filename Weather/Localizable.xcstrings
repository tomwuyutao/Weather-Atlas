    "Tap anywhere on the map to search that area. Or use the Find Sun button to search more broadly." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf eine Stelle auf der Karte, um diesen Bereich zu durchsuchen. Oder nutze die Taste „Sonne finden“, um umfassender zu suchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
