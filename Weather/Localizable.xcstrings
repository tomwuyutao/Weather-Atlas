          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь любого места на карте, чтобы найти солнце в этом районе. Или используйте кнопку «Найти солнце» для более широкого поиска."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
