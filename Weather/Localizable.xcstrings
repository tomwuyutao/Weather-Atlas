    "Save a city to add it to this map." : {
      "comment" : "A message encouraging the user to save a city to view it on the map.",
      "isCommentAutoGenerated" : true
    },
    "Save a new place here or add one of your existing places to %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichere hier einen neuen Ort oder füge %@ einen vorhandenen Ort hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save a new place here or add one of your existing places to %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda aquí un lugar nuevo o añade a %@ uno de tus lugares existentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez un nouveau lieu ici ou ajoutez à %@ l’un de vos lieux existants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva un nuovo luogo qui o aggiungi uno dei tuoi luoghi esistenti a %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここで新しい場所を保存するか、保存済みの場所を%@に追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기에 새 장소를 저장하거나 기존 장소 중 하나를 ‘%@’ 컬렉션에 추가하세요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde aqui um novo local ou adicione um dos locais existentes a %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраните здесь новое место или добавьте одно из уже сохранённых мест в коллекцию «%@»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此保存新地点，或将已有地点添加到“%@”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此儲存新地點，或將已有的地點加入「%@」。"
          }
        }
      }
    },
    "Save cities you care about. You can organize them into optional collections later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
