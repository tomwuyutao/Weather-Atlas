          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les collections organisent les lieux enregistrés sans les supprimer de « Tous les lieux »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le raccolte organizzano i luoghi salvati senza rimuoverli da Tutti i luoghi."
