    "Collections are optional ways to group saved places." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collections are optional ways to group saved places."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Sammlungen lassen sich gespeicherte Orte optional gruppieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las colecciones permiten agrupar lugares guardados de forma opcional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les collections permettent de regrouper facultativement des lieux enregistrés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le raccolte sono modi facoltativi per raggruppare i luoghi salvati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コレクションを使うと、保存した場所を必要に応じてグループ分けできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컬렉션을 사용하면 저장한 장소를 필요에 따라 그룹으로 묶을 수 있습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As coleções são uma forma opcional de agrupar locais guardados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коллекции позволяют при необходимости группировать сохранённые места."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集合可按需将已保存地点分组。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集合可依需要將已儲存的地點分組。"
          }
        }
      }
    },
    "Collections are optional. All saved places remain available in All Places." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collections are optional. All saved places remain available in All Places."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammlungen sind optional. Alle gespeicherten Orte bleiben unter „Alle Orte“ verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las colecciones son opcionales. Todos los lugares guardados permanecen disponibles en «Todos los lugares»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les collections sont facultatives. Tous les lieux enregistrés restent disponibles dans « Tous les lieux »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le raccolte sono facoltative. Tutti i luoghi salvati rimangono disponibili in Tutti i luoghi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コレクションは任意です。保存した場所はすべて「すべての場所」に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컬렉션은 선택 사항입니다. 저장한 모든 장소는 계속 ‘모든 장소’에서 볼 수 있습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As coleções são opcionais. Todos os locais guardados permanecem disponíveis em “Todos os locais”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коллекции необязательны. Все сохранённые места остаются в разделе «Все места»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集合是可选的。所有已保存地点仍可在“所有地点”中找到。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集合並非必要。所有已儲存的地點仍可在「所有地點」中找到。"
          }
        }
      }
    },
    "Collections are optional. Create one when you want to group places." : {
