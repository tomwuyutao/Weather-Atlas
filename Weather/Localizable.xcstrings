    "Deleting a collection removes only the grouping. Its places stay in All Places." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Löschen einer Sammlung wird nur die Gruppierung entfernt. Die Orte bleiben unter „Alle Orte“ erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting a collection removes only the grouping. Its places stay in All Places."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al eliminar una colección solo se elimina la agrupación. Sus lugares permanecen en «Todos los lugares»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression d’une collection supprime uniquement le regroupement. Ses lieux restent dans « Tous les lieux »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’eliminazione di una raccolta rimuove solo il raggruppamento. I luoghi restano in “Tutti i luoghi”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コレクションを削除しても、グループ分けだけが解除されます。場所は「すべての場所」に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컬렉션을 삭제해도 그룹만 해제됩니다. 장소는 ‘모든 장소’에 그대로 남습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao apagar uma coleção, apenas o agrupamento é removido. Os respetivos locais permanecem em “Todos os locais”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При удалении коллекции удаляется только группировка. Места остаются в разделе «Все места»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除集合只会移除分组。地点仍保留在“所有地点”中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除集合只會移除分組。地點仍會保留在「所有地點」中。"
          }
        }
      }
    },
