        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression d’une collection supprime uniquement le regroupement. Ses lieux restent dans « Tous les lieux »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
