    "Tap anywhere on the map to query that area, or use Find Sun to search more broadly." : {
      "comment" : "A tip message for the \"Map\" contextual feature tip.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf die Karte, um das Gebiet abzufragen, oder nutze „Sonne suchen“ für eine umfassendere Suche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap anywhere on the map to query that area, or use Find Sun to search more broadly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca cualquier lugar del mapa para consultar esa zona o usa Buscar sol para ampliar la búsqueda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez la carte pour interroger cette zone, ou utilisez Rechercher le soleil pour élargir la recherche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un punto sulla mappa per analizzare l’area oppure usa Trova il sole per cercare più ampiamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地図上の場所をタップしてそのエリアを検索するか、「晴れた場所を検索」で広く探します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지도에서 아무 곳이나 탭해 해당 지역을 검색하거나 햇빛 찾기로 더 넓게 검색하세요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em qualquer ponto do mapa para consultar essa área ou use Encontrar sol para pesquisar mais amplamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите в любом месте карты, чтобы проверить область, или используйте «Искать солнце» для более широкого поиска."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击地图上的任意位置查询该区域，或使用“查找阳光”进行更广泛的搜索。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點選地圖上的任意位置查詢該區域，或使用「尋找陽光」進行更廣泛的搜尋。"
          }
        }
      }
    },
    "Tap anywhere on the map to search that area. Or use the Find Sun button to search more broadly." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
