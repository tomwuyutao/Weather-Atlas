    "Choose a city to track its sunny daytime hours." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Stadt aus, um ihre sonnigen Tagesstunden zu verfolgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a city to track its sunny daytime hours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una ciudad para seguir sus horas de sol durante el día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une ville pour suivre ses heures d’ensoleillement en journée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una città per monitorare le ore di sole diurne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "晴れている昼間の時間を確認する都市を選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "낮 동안 맑은 시간을 확인할 도시를 선택하세요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma cidade para acompanhar as horas de sol durante o dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите город, чтобы отслеживать солнечные часы в течение дня."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一座城市来追踪其白天的晴朗时段。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇一座城市來追蹤其白天的晴朗時段。"
          }
        }
      }
    },
